{
  "name": "dont-stop",
  "version": "1.0.4",
  "private": true,
  "description": "DON'T STOP - installable game for Android and Windows",
  "author": "stikerpo",
  "main": "electron/main.cjs",
  "scripts": {
    "android:sync": "npx cap sync android",
    "desktop:start": "electron .",
    "desktop:build": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.stikerpo.dontstop.desktop",
    "productName": "DON'T STOP",
    "artifactName": "DONT-STOP-Setup.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "game.html",
      "game.js",
      "save.js",
      "update.js",
      "manifest.webmanifest",
      "icon.svg"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DON'T STOP",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
